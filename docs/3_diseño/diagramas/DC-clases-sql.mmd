    %% Relaciones
    actividad "0..*" --> "1" planificacion : id_planificacion
    actividad "0..*" --> "0..1" ubicacion : id_ubicacion
    agenda "0..*" --> "1" usuario : id_usuario
    asignacion_actividad "0..*" --> "1" miembros_proyecto : id_miembro
    asignacion_actividad "0..*" --> "1" actividad : id_actividad
    asignacion_actividad "0..*" --> "0..1" requerimiento_actividad : id_requerimiento_act
    auditoria "0..*" --> "1" tipo_accion_auditoria : id_tipo_auditoria
    auditoria "0..*" --> "0..1" usuario : id_usuario
    auditoria "0..*" --> "0..1" tipo_evento_auditoria : tipo_evento
    bloqueo_agenda "0..*" --> "1" agenda : id_agenda
    calificacion_perfil "0..*" --> "1" proyecto : id_proyecto
    calificacion_perfil "0..*" --> "1" perfil : id_perfil_emisor
    calificacion_perfil "0..*" --> "1" perfil : id_perfil_receptor
    caracteristica_perfil "0..*" --> "1" perfil : id_perfil
    caracteristica_perfil "0..*" --> "1" valor_caracteristica : id_valor,id_caracteristica
    caracteristica_perfil "0..*" --> "1" caracteristica_tecnica : id_caracteristica
    caracteristica_tecnica "0..*" --> "1" profesion : id_profesion
    caracteristica_tecnica "0..*" --> "0..1" unidad_medida : id_unidad
    ciudad "0..*" --> "1" provincia : id_provincia
    colaborador_publicacion "0..*" --> "1" publicacion : id_publicacion
    colaborador_publicacion "0..*" --> "1" perfil : id_perfil
    comentario "0..*" --> "1" publicacion : id_publicacion
    comentario "0..*" --> "1" perfil : id_perfil
    conexion "0..*" --> "1" perfil : id_perfil_1
    conexion "0..*" --> "1" perfil : id_perfil_2
    conexion "0..*" --> "1" solicitud_conexion : id_solicitud_conexion
    contrato "0..*" --> "1" proyecto : id_proyecto
    contrato "0..*" --> "1" tipo_acuerdo_contrato : id_tipo_acuerdo
    contrato "0..*" --> "1" miembros_proyecto : id_miembro_emisor
    contrato_evento "0..*" --> "1" contrato : id_contrato
    contrato_evento "0..*" --> "0..1" miembros_proyecto : id_miembro
    contrato_evento "0..*" --> "0..1" usuario : id_usuario
    contrato_evento "0..*" --> "0..1" contrato_version : id_contrato_version
    contrato_version "0..*" --> "1" contrato : id_contrato
    contrato_version "0..*" --> "0..1" usuario : id_usuario
    conversacion "0..*" --> "1" perfil : id_perfil_1
    conversacion "0..*" --> "1" perfil : id_perfil_2
    dependencia_actividades "0..*" --> "1" actividad : id_actividad_predecesora
    dependencia_actividades "0..*" --> "1" actividad : id_actividad_sucesora
    detalle_auditoria "0..*" --> "1" auditoria : id_auditoria
    firma_contrato "0..*" --> "1" contrato : id_contrato
    firma_contrato "0..*" --> "1" miembros_proyecto : id_miembro
    firma_contrato "0..*" --> "0..1" contrato_version : id_contrato_version
    habilidad_perfil "0..*" --> "1" perfil : id_perfil
    habilidad_perfil "0..*" --> "1" habilidad : id_habilidad
    hito "0..*" --> "1" proyecto : id_proyecto
    hito_actividad "0..*" --> "1" hito : id_hito
    hito_actividad "0..*" --> "1" actividad : id_actividad
    imagen_moodboard "0..*" --> "1" imagen : id_imagen
    imagen_moodboard "0..*" --> "1" moodboard : id_moodboard
    imagen_publicacion "0..*" --> "1" imagen : id_imagen
