    class perfil_tyc {
        <<table>>
        +int8 id_perfil PK/FK
        +int8 id_tyc PK
        +text descripcion
        +timestamp fecha_inicio
        +timestamp? fecha_fin
    }

    class permiso_global {
        <<table>>
        +int8 id_permiso_global PK
        +varchar nombre
    }

    class permiso_proyecto {
        <<table>>
        +int8 id_permiso_proyecto PK
        +varchar nombre
    }

    class planificacion {
        <<table>>
        +int8 id_planificacion PK
