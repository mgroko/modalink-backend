        +varchar rol_parte
        +varchar estado_firma
        +timestamp? fecha_firma
        +timestamp? fecha_rechazo
        +varchar? motivo_rechazo
    }

    class genero {
        <<table>>
        +int8 id_genero PK
        +varchar codigo
        +varchar nombre
    }

    class grupo_polaroid {
        <<table>>
        +int8 id_grupo_polaroid PK
