        +int8? id_proyecto FK
        +int8? id_ubicacion FK
        +varchar titulo
        +varchar? descripcion
        +varchar estado
        +timestamp fecha_publicacion
    }

    class reemplazo {
        <<table>>
        +int8 id_reemplazo PK
        +int8 id_proyecto FK
        +int8? id_actividad FK
        +int8? id_requerimiento_act FK
        +int8? id_requerimiento_gral FK
