        +timestamp fecha_envio
        +varchar estado
        +timestamp? fecha_rechazo
    }

    class invitacion_gral {
        <<table>>
        +int8 id_invitacion_gral PK
        +int8 id_perfil_destinatario FK
        +int8 id_perfil_remitente FK
        +int8 id_proyecto FK
        +int8? id_requerimiento_gral FK
        +int8? id_tyc_aceptado FK
        +varchar? mensaje
        +timestamp fecha_envio
        +varchar estado
    }

    class jornada_agenda {
        <<table>>
        +int8 id_jornada PK
        +int8 id_agenda FK
        +int4 dia_semana
        +time hora_inicio_manana
        +time? hora_fin_manana
        +time? hora_inicio_tarde
        +time hora_fin_tarde
    }

    class me_gusta {
        <<table>>
        +int8 id_publicacion PK/FK
        +int8 id_perfil PK/FK
        +timestamp fecha
    }

    class mensaje {
        <<table>>
        +int8 id_mensaje PK
        +int8 id_conversacion FK
        +int8 id_perfil_emisor FK
        +varchar contenido
        +timestamp fecha_envio
        +boolean leido
        +timestamp? fecha_lectura
    }

    class mensaje_proyecto {
        <<table>>
        +int8 id_mensaje_proyecto PK
        +int8 id_proyecto FK
        +int8 id_perfil_emisor FK
        +varchar contenido
        +timestamp fecha_envio
    }

    class miembros_proyecto {
        <<table>>
        +int8 id_miembro PK
        +int8 id_rol_proyecto FK
        +int8 id_proyecto FK
        +int8 id_perfil FK
        +int8? id_tyc_aceptado FK
        +int8? id_requerimiento_gral FK
        +int8? id_perfil_autor_baja FK
        +timestamp fecha_alta
        +timestamp? fecha_baja
    }

    class moodboard {
        <<table>>
        +int8 id_moodboard PK
        +int8 id_proyecto FK
        +timestamp fecha_creacion
        +varchar? descripcion
    }

    class notificacion {
        <<table>>
        +int8 id_notificacion PK
        +varchar tipo FK
        +int8 id_usuario_destino FK
        +int8? id_perfil_contexto FK
        +text mensaje
        +varchar origen
        +varchar? entidad_tipo
        +int8? entidad_id
        +boolean leida
    }

    class notificacion_entrega {
        <<table>>
        +int8 id_entrega PK
        +int8 id_notificacion FK
        +varchar canal
        +varchar estado
        +timestamp? fecha_envio
        +int intentos
        +timestamp? proximo_intento
        +timestamp? fecha_ultimo_intento
        +varchar? error
    }

    class notificacion_preferencia {
        <<table>>
        +int8 id_usuario PK/FK
        +varchar tipo PK/FK
        +varchar canal PK
        +boolean activo
    }

    class notificacion_tipo {
        <<table>>
        +varchar codigo PK
        +varchar nombre
        +varchar prioridad
        +boolean activo
        +varchar categoria
    }

    class objetivo {
        <<table>>
        +int8 id_objetivo PK
        +int8 id_proyecto FK
