classDiagram
    %% Modelo de clases basado en ModaLinkBD.sql
    %% PK = PRIMARY KEY; FK = FOREIGN KEY.

    class actividad {
        <<table>>
        +int8 id_actividad PK
        +int8 id_planificacion FK
        +int8? id_ubicacion FK
        +varchar estado
        +varchar nombre
        +varchar? descripcion
        +int4 duracion_minutos
        +timestamp? fecha_hora_inicio
        +time? horario_preferencia_inicio
    }

    class agenda {
        <<table>>
        +int8 id_agenda PK
        +int8 id_usuario FK
        +int4 margen_actividad_min
    }

    class asignacion_actividad {
        <<table>>
        +int8 id_asignacion_act PK
        +int8 id_miembro FK
        +int8 id_actividad FK
        +int8? id_requerimiento_act FK
    }

    class auditoria {
        <<table>>
        +int8 id_auditoria PK
        +int8 id_tipo_auditoria FK
        +int8? id_usuario FK
        +varchar? tipo_evento FK
        +varchar usuario_bd
        +varchar entidad_afectada
        +varchar? entidad_clave
        +int8 id_afectado
        +timestamp fecha_hora
    }

    class bloqueo_agenda {
        <<table>>
        +int8 id_bloqueo PK
        +int8 id_agenda FK
        +timestamp fecha_hora_inicio
        +timestamp fecha_hora_fin
        +varchar motivo
    }

    class calificacion_perfil {
        <<table>>
        +int8 id_calificacion PK
        +int8 id_proyecto FK
        +int8 id_perfil_emisor FK
        +int8 id_perfil_receptor FK
        +int4 valoracion
        +varchar resenia
        +timestamp fecha_registro
    }

    class caracteristica_perfil {
        <<table>>
        +int8 id_caracteristica_perfil PK
        +int8 id_perfil FK
        +int8? id_valor FK
        +int8 id_caracteristica FK
        +varchar? valor
        +timestamp fecha_registro
    }

    class caracteristica_tecnica {
        <<table>>
        +int8 id_caracteristica PK
        +int8 id_profesion FK
        +int8? id_unidad FK
        +varchar codigo
        +varchar? nombre
        +varchar tipo_dato
    }

    class ciudad {
        <<table>>
        +int8 id_ciudad PK
        +int8 id_provincia FK
        +varchar nombre
        +boolean activo
        +varchar? codigo_postal
        +varchar id_externo
        +varchar fuente_api
        +decimal? longitud_defecto
        +decimal? latitud_defecto
    }

    class colaborador_publicacion {
        <<table>>
        +int8 id_publicacion PK/FK
        +int8 id_perfil PK/FK
    }

    class comentario {
        <<table>>
        +int8 id_comentario PK
        +int8 id_publicacion FK
        +int8 id_perfil FK
        +varchar? texto
        +timestamp fecha_comentario
    }

    class conexion {
        <<table>>
        +int8 id_conexion PK
        +int8 id_perfil_1 FK
        +int8 id_perfil_2 FK
        +int8 id_solicitud_conexion FK
        +varchar estado
        +timestamp fecha_inicio_conexion
        +timestamp? fecha_fin_conexion
    }

    class configuracion_sistema {
        <<table>>
        +varchar clave PK
        +text valor
        +varchar? descripcion
    }

    class contrato {
        <<table>>
        +int8 id_contrato PK
        +int8 id_proyecto FK
        +int8 id_tipo_acuerdo FK
        +int8 id_miembro_emisor FK
        +varchar nombre
        +varchar? descripcion
        +text? texto
        +timestamp fecha_creacion
        +timestamp? fecha_baja
    }

    class contrato_evento {
        <<table>>
        +int8 id_evento PK
        +int8 id_contrato FK
        +int8? id_miembro FK
        +int8? id_usuario FK
        +int8? id_contrato_version FK
        +varchar tipo_evento
        +timestamp fecha_hora
        +varchar? motivo
    }

    class contrato_version {
        <<table>>
        +int8 id_contrato_version PK
        +int8 id_contrato FK
        +int8? id_usuario FK
        +int version
        +text texto
        +timestamp fecha_creacion
    }

    class conversacion {
        <<table>>
        +int8 id_conversacion PK
        +int8 id_perfil_1 FK
        +int8 id_perfil_2 FK
        +timestamp fecha_creacion
        +timestamp? fecha_ultimo_mensaje
