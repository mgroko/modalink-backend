    }

    class postulacion_gral {
        <<table>>
        +int8 id_postulacion_gral PK
        +int8 id_perfil FK
        +int8 id_requerimiento_gral FK
        +varchar estado
        +timestamp fecha_postulacion
    }

    class profesion {
        <<table>>
        +int8 id_profesion PK
        +varchar codigo
        +varchar nombre
        +varchar? descripcion
    }

    class provincia {
        <<table>>
        +int8 id_provincia PK
