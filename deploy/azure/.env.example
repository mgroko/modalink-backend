# =============================================================
# ModaLink - Azure VM
# Copiar a .env y completar. NO commitear .env.
#   cp .env.example .env
#   chmod 600 .env
# =============================================================

# -------------------------------------------------------------
# Hostname público (DuckDNS) y URL base
# -------------------------------------------------------------
# Producción con HTTPS:
SITE_ADDRESS=modalink.duckdns.org
SITE_URL=https://modalink.duckdns.org

# Prueba local sin HTTPS (opcional):
# SITE_ADDRESS=:80
# SITE_URL=http://localhost
# COOKIE_SECURE=false

# -------------------------------------------------------------
# Imágenes publicadas por GitHub Actions en GHCR
# -------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/mgroko/modalink-backend:latest
WEB_IMAGE=ghcr.io/mgroko/modalink-frontend:latest

# -------------------------------------------------------------
# PostgreSQL
# -------------------------------------------------------------
POSTGRES_DB=modalink
POSTGRES_USER=modalink
POSTGRES_PASSWORD=CAMBIAR_por_un_password_largo_y_random

# -------------------------------------------------------------
# JWT y administrador inicial
# -------------------------------------------------------------
# Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_por_un_secreto_de_al_menos_64_caracteres
JWT_EXPIRATION_MS=3600000

ADMIN_EMAIL=admin@modalink.local
ADMIN_PASSWORD=CAMBIAR_por_un_password_fuerte
ADMIN_DNI=00000000

# -------------------------------------------------------------
# Google OAuth (opcional)
# Agregar en Google Cloud Console:
#   https://TU_DOMINIO/login/oauth2/code/google
# -------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------------------------------------
# Email (opcional). Desactivado por defecto.
# Ejemplo con Brevo:
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   SPRING_MAIL_USERNAME=tu_usuario
#   SPRING_MAIL_PASSWORD=tu_smtp_key
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
#   SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# -------------------------------------------------------------
NOTIFICACIONES_EMAIL_HABILITADO=false
NOTIFICACIONES_EMAIL_REMITENTE=no-responder@modalink.local
# false = no chequea SMTP en /actuator/health (recomendado si los emails están off)
MANAGEMENT_HEALTH_MAIL_ENABLED=false
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# -------------------------------------------------------------
# Cookies
# En producción con HTTPS dejar true y Lax (mismo origen).
# -------------------------------------------------------------
COOKIE_SECURE=true
COOKIE_SAME_SITE=Lax

# -------------------------------------------------------------
# Rendimiento
# En una VM de 4 GB, 50% de heap = 2 GB.
# La colaboración automática usa OpenCV; desactivarla ahorra CPU.
# -------------------------------------------------------------
APP_COLABORACION_AUTOMATICA_HABILITADA=false
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50 -XX:+UseSerialGC -Djava.awt.headless=true --enable-native-access=ALL-UNNAMED

# -------------------------------------------------------------
# Zona horaria
# -------------------------------------------------------------
TZ=America/Argentina/Buenos_Aires
